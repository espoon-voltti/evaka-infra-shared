{
  "name": "evaka-infra-shared",
  "version": "1.0.0",
  "description": "Shared Terraform modules for eVaka deployments",
  "scripts": {
    "prettier": "prettier --write .",
    "lint:prettier": "prettier --check .",
    "test": "npm run test:slack-notifier && npm run test:ops-metrics",
    "test:slack-notifier": "node --loader ./modules/slack-notifier/lambda/mock-aws-loader.mjs --test 'modules/slack-notifier/**/*.test.mjs'",
    "test:ops-metrics": "node --loader ./modules/ops-metrics/lambda/mock-aws-loader.mjs --test 'modules/ops-metrics/**/*.test.mjs'"
  },
  "private": true,
  "license": "LGPL-2.1-or-later",
  "devDependencies": {
    "prettier": "3.8.3"
  }
}
